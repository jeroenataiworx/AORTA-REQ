<urn:researchmaster:aorta:req:9335d75b-5561-d136-84b7-0c8fb2cd7f8e> a rm:Requirement;
    dcterms:identifier "9335D75B-5561-D136-84B7-0C8FB2CD7F8E";
    dcterms:title " Registratie gebruik Mitz-toestemmingsknop ";
    ea:alias "GBX.MITZ.0420 ";
    dcterms:description """Wanneer een zorgverlener namens een pati&#235;nt toestemmingskeuzes vastlegt via de toestemmingsknop, moet dit, na de bevestiging dat de toestemmingskeuzes zijn vastgelegd in Mitz, zowel geregistreerd worden in het systeemlog (conform NEN:7513) als in het dossier van de pati&#235;nt. 
Minimaal moeten de volgende gegevens worden geregistreerd:  
•  Identificatie zorgverlener (UZI-nummer) 
•  Datum en tijd 
•  Situatiecode van de desbetreffende toestemmingsknop 
•  Toestemmingskeuze Ja/Nee. 
<b>Functie</b>  
Voldoen aan wet- en regelgeving en transparantie naar de pati&#235;nt. 
<b>Toelichting</b>  
Wanneer er onduidelijkheid is over toestemmingskeuzes, kan eenvoudig en snel worden nagegaan wie welke toestemmingen heeft vastgelegd. """;
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Proposed";
    ea:version "1.0";
    dcterms:creator "Rob den Braasem";
    dcterms:created "2021-12-21 10:49:07";
    dcterms:modified "2021-12-21 10:53:11";
