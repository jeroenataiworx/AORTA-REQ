<urn:researchmaster:aorta:req:85025b04-c514-6643-9e2a-53e72ecca1e9> a rm:Requirement;
    dcterms:identifier "85025B04-C514-6643-9E2A-53E72ECCA1E9";
    dcterms:title "Ondersteunde gegevensdiensten";
    ea:alias "DVZA.FUN.e4110.1";
    dcterms:description """<b>Eis:</b>
De DVZA dient de volgende MedMij gegevensdiensten te ondersteunen: 
<ul>
	<li>Verzamelen Medicatiegegevens (medicatieafspraken, verstrekkingsverzoeken, verstrekkingen);</li>
	<li>Verzamelen huisartsgegevens;</li>
	<li>Verzamelen Medicatiegerelateerde Overgevoeligheden;</li>
	<li>Verzamelen Documenten.</li>
</ul>
<b>
</b><b>Toelichting: </b>
MedMij beschrijft verschillende gegevensdiensten. Mogelijk kunnen niet alle gegevensdiensten (nu of in de toekomst) ingevuld worden door de AORTA-infrastructuur en dus door de DVZA. In deze eis wordt expliciet gemaakt welke gegevensdiensten ondersteund moeten worden door de DVZA. """;
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Definitief";
    ea:version "8.1.0.0";
    dcterms:creator "Bart Hoenderboom";
