<urn:researchmaster:aorta:req:8f26dd7f-6c08-7da2-9c43-063eb97cbe83> a rm:Requirement;
    dcterms:identifier "8F26DD7F-6C08-7DA2-9C43-063EB97CBE83";
    dcterms:title "Beheerder van de ZIM";
    ea:alias "LSP.BHB.e4011";
    dcterms:description """Voor de toegang tot beheertaken kunnen in de beheerderapplicatie meerdere rollen worden gedefinieerd, waarbij de verschillende beheertaken door middel van configuratie aan de verschillende rollen kunnen worden toegekend. Tot de lijst van rollen behoort tenminste de rol van <i>LSP-beheerder</i>.
De beheertaken van de ZIM zoals genoemd onder de eisen in dit hoofdstuk kunnen worden uitgevoerd door een gebruiker van de beheerapplicatie die is ingelogd in de rol van systeembeheerder voor de desbetreffende omgeving (test/acceptatie/productie) van de ZIM, tenzij anders vermeld.

<b>Functie</b>
Het configureerbaar maken van de verdeling van beheertaken over verschillende beheerrollen.""";
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Proposed";
    ea:version "1.0";
    dcterms:creator "Rob den Braasem";
    dcterms:created "2020-03-17 13:39:02";
    dcterms:modified "2020-03-17 13:39:57";
    dcterms:source "Eisen_AORTA_Infrastructuur_nf_xml.xml";
    dcterms:source "Eisen_AORTA_Infrastructuur_xmi_11.xml";
    dcterms:source "Eisen_AORTA_Infrastructuur_xmi_21.xml";
