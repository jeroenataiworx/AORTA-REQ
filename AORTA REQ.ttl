    <http://purl.org/dc/terms/isPartOf> <urn:researchmaster:aorta:req:842caca1-753e-6933-aa0b-314ea10396d8> .

<urn:researchmaster:aorta:req:b55689b3-84cc-0beb-959d-4a8b7a3a1793> a rm:Requirement;
    dcterms:identifier "B55689B3-84CC-0BEB-959D-4A8B7A3A1793";
    dcterms:title "Protocolstack voor gegevensuitwisseling o.b.v. FHIR";
    ea:alias "GBX.CON.e4130.1";
    dcterms:description """<b>Eis:</b>
Het GBx dient voor berichtuitwisseling met de ZIM de volgende protocolstack te gebruiken:
<ul>
	<li>HL7 FHIR</li>
	<li>JWT</li>
	<li>HTTP v1.1/HTTP v2.0</li>
	<li>TLS 1.3</li>
	<li>TCP</li>
	<li>IPv4</li>
</ul>

<b>Toelichting bij eis:</b>
Het is niet toegestaan om een lagere protocolversie te hanteren dan die in deze protocolstack vermeld is.""";
    ea:stereotype "ArchiMate_Requirement";
