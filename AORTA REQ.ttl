<urn:researchmaster:aorta:req:ab1947de-5c20-4249-ad6b-2bfe78bddbff> a rm:Requirement;
    dcterms:identifier "AB1947DE-5C20-4249-AD6B-2BFE78BDDBFF";
    dcterms:title "Autoriseren cliëntsysteem";
    ea:alias "COMP.BEV.e4090";
    dcterms:description """<b>Eis:</b>
Voor het uiteindelijke gebruik van een geaccepteerde beveiligde verbinding dient het stelsteltoken te worden gecontroleerd. 
<b>
</b><b>Toelichting bij eis:</b>
Alleen geautoriseerde systemen kunnen gebruik maken van de functionaliteiten van een component. Om een systeem te onderscheiden als geautoriseerd, dient na het opzetten van een verbinding het aanwezige stelsteltoken gecontroleerd te worden. """;
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Definitief";
    ea:version "8.4.0.0";
    dcterms:creator "Bart Hoenderboom";
    dcterms:created "2022-12-30 09:58:52";
    dcterms:modified "2022-12-30 10:06:50";
    dcterms:source "Eisen_AORTA_Infrastructuur_nf_xml.xml";
    dcterms:source "Eisen_AORTA_Infrastructuur_xmi_11.xml";
