<urn:researchmaster:aorta:req:ae2e95ef-2211-6be7-89fb-228c880fc211> a rm:Requirement;
    dcterms:identifier "AE2E95EF-2211-6BE7-89FB-228C880FC211";
    dcterms:title "Toetsen token exchange request";
    ea:alias "DVZA.OTE.e4060";
    dcterms:description """<b>Eis:</b>
<b>
</b>De autorisatieserver dient na ontvangst van een token exchange request de volgende zaken te controleren:
<ul>
	<li>De afzender van het token exchange request dient gestuurd te zijn door de resource server van LSP+;</li>
	<li>Het MedMij access token moet bekend zijn bij de autorisatieserver van LSP+;</li>
	<li>De autorisatiesessie op de autorisatieserver van LSP+ mag niet verlopen zijn.</li>
</ul>
<b>
</b><b>Toelichting bij eis:</b>
""";
