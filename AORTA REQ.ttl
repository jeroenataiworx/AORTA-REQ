<ul>
	<li>issuer;</li>
	<li>authorization_endpoint;</li>
	<li>token_endpoint;</li>
	<li>jwks_uri;</li>
	<li>response_types_supported;</li>
	<li>signed_metadata.</li>
</ul>
<b>
</b><b>Toelichting bij eis:</b>""";
