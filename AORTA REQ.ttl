<urn:researchmaster:aorta:req:8bfcd7ba-fb84-6bc8-b54a-05ce249a99ce> a rm:Requirement;
    dcterms:identifier "8BFCD7BA-FB84-6BC8-B54A-05CE249A99CE";
    dcterms:title "Verwerken Mitz-notificaties ";
    ea:alias "GBX.MITZ.0310";
    dcterms:description """Het LSP ontvangt van Mitz notificaties in FHIR-formaat. Wanneer de zorgaanbieder heeft aangegeven om Mitz-notificaties te ontvangen, dan stuurt het LSP deze berichten door naar het XIS met een HL7v3-wrapper. Het XIS moet de FHIR-payload uit dit HL7v3-bericht kunnen interpreteren om de Mitz-notificaties te kunnen verwerken volgens de [IH MANR]. (PXAC_IN990010NL01) 
<b>Functie</b>  
Ondersteuning Mitz 
<b>Karakter </b> 
Verplicht indien optie notificaties ontvangen is geactiveerd. 
<b>Toelichting</b>  
De FHIR-payload uit het ontvangen HL7v3-bericht verwerken in het XIS. 
Met de Mitz-notificaties kan bijvoorbeeld in het XIS getoond worden of een pati&#235;nt relevante toestemmingen heeft vastgelegd voor de zorgaanbieder. """;
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Proposed";
    ea:version "1.0";
    dcterms:creator "Rob den Braasem";
