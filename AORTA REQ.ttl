<urn:researchmaster:aorta:req:9e38f131-370c-8f24-b02a-6134660a4a32> a rm:Requirement;
    dcterms:identifier "9E38F131-370C-8F24-B02A-6134660A4A32";
    dcterms:title "Koppelvlak ZIM";
    ea:alias "LSP.CON.e4040 ";
    dcterms:description """De ZIM is via de routeerfunctie gekoppeld met de GBx’en. De routeerfunctie dient tevens het IP-verkeer tussen GBZ’en onderling te ondersteunen, waarbij deze GBZ’en verschillende GZN-verbindingen van verschillende GZN’en kunnen hebben.
Een GZN-verbinding met het netwerk van het LSP moet via een redundante koppeling worden gerealiseerd.

<b>Functie</b>
Het doel van deze eis is dat:
•	GBx’en elkaar onderling via een netwerk kunnen bereiken;
•	GBx’en en de ZIM elkaar via een netwerk kunnen bereiken

<b>Toelichting</b>
Zie paragraaf 14.1.3 van [Arch AORTA]

""";
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Proposed";
    ea:version "1.0";
    dcterms:creator "Rob den Braasem";
    dcterms:created "2020-03-18 13:45:16";
    dcterms:modified "2020-03-18 13:46:54";
    dcterms:source "Eisen_AORTA_Infrastructuur_nf_xml.xml";
    dcterms:source "Eisen_AORTA_Infrastructuur_xmi_11.xml";
    dcterms:source "Eisen_AORTA_Infrastructuur_xmi_21.xml";
