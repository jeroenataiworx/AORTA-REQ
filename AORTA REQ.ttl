<urn:researchmaster:aorta:req:baf4c01d-7b58-b3ed-a80b-a5dde15b75cb> a rm:Requirement;
    dcterms:identifier "BAF4C01D-7B58-B3ED-A80B-A5DDE15B75CB";
    dcterms:title "Loggen beheeracties";
    ea:alias "DVZA.BEH.e4080";
    dcterms:description """<b>Eis:</b>
<b>
</b>Alle beheeracties die uitgevoerd worden op de DVZA dienen door het DVZA gelogd te worden.  

<b>Toelichting bij eis:</b>

Het gaat hierbij bijvoorbeeld om beheeracties die impact (kunnen) hebben op:
<ul>
	<li>De beveiliging van de DVZA;</li>
	<li>De opvraag richting AORTA;</li>
	<li>De diverse vertalingen.</li>
</ul>
Met betrekking tot beveiliging worden onder andere zaken met betrekking tot autorisatie en authenticatie bedoeld.    """;
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Definitief";
    ea:version "8.1.0.0";
    dcterms:creator "Bart Hoenderboom";
    dcterms:created "2018-10-30 10:08:40";
    dcterms:modified "2020-06-22 11:50:45";
