<urn:researchmaster:aorta:req:a4ae0cc1-d349-df56-bd16-3bfa5d598ae6> a rm:Requirement;
    dcterms:identifier "A4AE0CC1-D349-DF56-BD16-3BFA5D598AE6";
    dcterms:title "Systeemrol activeren Mitz-toestemmingsknop ";
    ea:alias "GBX.MITZ.0400 ";
    dcterms:description """Voordat een zorgverlener gebruik kan maken van een in het XIS ingebouwde toestemmingsknop, moet in het XIS de systeemrol voor het gebruik van de toestemmingsknop worden geactiveerd door de 
bijbehorende TKID "Toestemming Gevend Systeem" (PXAC_IN990030NL01) naar het LSP te versturen. 
<b>
</b><b>Functie  </b>
Ondersteuning Mitz 

<b>Toelichting</b>  
Gebruik van een toestemmingsknop kenbaar maken door de systeemrol aan te zetten 
met de TKID " Toestemming Gevend Systeem". """;
    ea:stereotype "ArchiMate_Requirement";
