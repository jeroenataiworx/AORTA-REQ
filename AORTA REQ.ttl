<urn:researchmaster:aorta:req:8797ac02-8e11-b076-9881-9333625d2d45> a rm:Requirement;
    dcterms:identifier "8797AC02-8E11-B076-9881-9333625D2D45";
    dcterms:title "Configureerbare zorgtoepassingen";
    ea:alias "LSP.CZT.e4010 ";
    dcterms:description """Primaire informatiesysteeminteracties kunnen op de ZIM worden geconfigureerd op basis van een set aan configuratieparameters zoals beschreven in paragraaf 7.6 van [Arch AORTA]. Deze configuratieparameters kunnen op elk moment in de tijd worden aangeleverd door de LSP-opdrachtgever. Configureerbare zorgtoepassingen zijn hiermee niet gebonden aan een vaste AORTA-publicatie. 

<b>Functie</b>
Configureerbaar uitrollen van zorgtoepassingen

<b>Toelichting</b>
Configureerbare zorgtoepassingen zijn alleen maar mogelijk voor primaire informatiesysteeminteracties die gebruik maken van de standaard AORTA berichtafhandeling zoals beschreven in <b>LSP.ZIM.e4005</b>. """;
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Proposed";
    ea:version "1.0";
    dcterms:creator "Rob den Braasem";
