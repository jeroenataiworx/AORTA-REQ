<urn:researchmaster:aorta:req:b63bfd4f-194e-dbed-a451-69ee230f3a55> a rm:Requirement;
    dcterms:identifier "B63BFD4F-194E-DBED-A451-69EE230F3A55";
    dcterms:title "Controle van het autorisatieprotocol voor zorgverleners";
    ea:alias "LSP.AUT.e4010 ";
    dcterms:description """De ZIM autoriseert de zorgverlener/medewerker als bevoegd tot het zenden van het onderhavige bericht zoals beschreven onder ‘autoriseren van rol voor interactie’ in [Ontw APT].

<b>Functie</b>
Het controleren van de bevoegdheid van een zorgverlener/medewerker voordat berichten verder worden verwerkt door de ZIM.

<b>Toelichting</b>
Zie paragraaf 13.2.4 van [Arch AORTA] en [Ontw APT]""";
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Proposed";
    ea:version "1.0";
