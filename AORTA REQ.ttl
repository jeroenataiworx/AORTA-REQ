<urn:researchmaster:aorta:req:bffa8759-7867-3e5e-933f-d3e64c055f78> a rm:Requirement;
    dcterms:identifier "BFFA8759-7867-3E5E-933F-D3E64C055F78";
    dcterms:title "Loggen toegangsregeling";
    ea:alias "LSP.LOG.e4045 ";
    dcterms:description """Elke wijziging in de toegangsregeling dient te worden gelogd. Hierbij moet onweerlegbaar kunnen worden vastgesteld welke persoon met welke rol welke specifieke aanpassing heeft doorgevoerd. 

<b>Functie</b>
Traceerbaarheid van aanpassingen in de toegangsregeling.

<b>Toelichting</b>
Conform NEN 7513:2018 Paragraaf 6.3 """;
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Proposed";
    ea:version "1.0";
    dcterms:creator "Rob den Braasem";
    dcterms:created "2020-03-19 13:58:34";
    dcterms:modified "2020-03-19 13:59:47";
    dcterms:source "Eisen_AORTA_Infrastructuur_nf_xml.xml";
