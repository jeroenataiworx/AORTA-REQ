<urn:researchmaster:aorta:req:a24edb81-6e30-c2ca-964e-ec6a999fc6fe> a rm:Requirement;
    dcterms:identifier "A24EDB81-6E30-C2CA-964E-EC6A999FC6FE";
    dcterms:title "Opvragen FHIR Resources t.b.v. Documenten";
    ea:alias "GBX.BER.e3070";
    dcterms:description """<b>Eis:</b>
Het systeem dient de FHIR-resources t.b.v. Documenten op te vragen en het antwoord te kunnen verwerken zoals is opgenomen in de betreffende zorgtoepassing. 
<b>
</b><b>Toelichting bij eis:</b>
Een verwijzing naar de FHIR-resources zijn opgenomen in de publicatiepagina op Confluence. 
""";
