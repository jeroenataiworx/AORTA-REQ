<urn:researchmaster:aorta:req:82ac1a14-11fe-e1a0-a83c-48f95d96be4c> a rm:Requirement;
    dcterms:identifier "82AC1A14-11FE-E1A0-A83C-48F95D96BE4C";
    dcterms:title "Inlezen MedMij-vertaling";
    ea:alias "DVZA.BEH.e4040";
    dcterms:description """<b>Eis:</b>
De DVZA dient de mogelijkheid te hebben om een door de DVZA-opdrachtgever aangeleverde XSLT op een door de DVZA-opdrachtgever te bepalen moment in te lezen. 

<b>Toelichting bij eis:</b>
Het betreft hier een XSLT('s) die het AORTA-resultaat omzet naar een opleverbericht volgens de MedMij-specificaties.""";
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Definitief";
    ea:version "8.1.0.0";
