<urn:researchmaster:aorta:req:95499674-1c1c-b57e-bac3-fc67d6d23ad2> a rm:Requirement;
    dcterms:identifier "95499674-1C1C-B57E-BAC3-FC67D6D23AD2";
    dcterms:title "Time-out tijdens vertaling";
    ea:alias "BTD.PRE.e4020";
    dcterms:description """<b>Eis:</b>
BTD moet een vertaling afbreken en een foutmelding terugsturen, indien deze langer dan 30 seconden bezig is. 
<b>
</b><b>Toelichting bij eis:</b>
BTD moet voorkomen dat het vertaalproces de communicatie te lang vertraagd door mogelijke fouten, complexe vertalingen en/of overbelasting. """;
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Proposed";
    ea:version "8.3.0.0";
