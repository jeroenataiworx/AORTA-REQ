<urn:researchmaster:aorta:req:b548c1de-2b1c-fb20-b2c4-6498c3e530b8> a rm:Requirement;
    dcterms:identifier "B548C1DE-2B1C-FB20-B2C4-6498C3E530B8";
    dcterms:title "Configureerbaar opbouwen ZIM";
    ea:alias "LSP.OND.e4010 ";
    dcterms:description """De ZIM dient in hoge mate configureerbaar te worden opgebouwd. Een hoge mate van configureerbaarheid wordt bereikt door waar mogelijk oplossingen configureerbaar op te bouwen. Via de ZIM beheerapplicatie moeten de betreffende configuratieinstellingen aangepast kunnen worden. Hiermee moet het mogelijk worden om bepaalde aanpassingen versneld door te kunnen voeren.

<b>Functie</b>
Configureerbaar opbouwen ZIM om onderhoudbaarheid te garanderen""";
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Proposed";
    ea:version "1.0";
    dcterms:creator "Rob den Braasem";
