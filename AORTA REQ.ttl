<urn:researchmaster:aorta:req:abd1fe37-9fda-ba94-9d19-2ba422b2274c> a rm:Requirement;
    dcterms:identifier "ABD1FE37-9FDA-BA94-9D19-2BA422B2274C";
    dcterms:title "Detectie van duplicaatberichten o.b.v. ClinicalDocument-id";
    ea:alias "GBX.OPV.e4212";
    dcterms:description """<b>Eis:</b>
Duplicaatdetectie dient plaats te vinden op basis van het ClinicalDocument-id in het bericht.

<b>Toelichting bij eis:</b>
Er dient duplicaatdetectie te worden uitgevoerd bij het verwerken van de verstuurberichten. Hierbij dient te worden gecontroleerd of het ClinicalDocument in het bericht, al eerder is verstuurd. De duplicaatdetectie dient op basis van het ClinicalDocument-id plaats te vinden.""";
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Definitief";
    ea:version "8.5.0.0";
