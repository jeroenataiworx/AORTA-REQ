<urn:researchmaster:aorta:req:b8ac7068-4de7-2c01-9e49-a04f61d7a086> a rm:Requirement;
    dcterms:identifier "B8AC7068-4DE7-2C01-9E49-A04F61D7A086";
    dcterms:title "Beheer GZN-verbinding";
    ea:alias "LSP.BHB.e4020 ";
    dcterms:description """De beheerapplicatie van de ZIM, waar nodig in combinatie met netwerkmanagement-applicaties, biedt functies voor:
<ul>
	<li>het toevoegen, wijzigen en verwijderen van de configuratiegegevens van een GZN-verbinding;</li>
	<li>het openstellen en blokkeren van de toegang van een GZN-verbinding tot de ZIM;</li>
	<li>het oproepen van een overzicht van de netwerkbelasting van een GZN-verbinding op de ZIM;</li>
</ul>
het registreren van het maximum en huidig aantal per GZN-verbinding aangesloten partijen.

<b>Functie</b>
Het beheer beschikt in voldoende mate over de juiste middelen en informatie om de configuratie van de op de ZIM aangesloten GZN-verbindingen te beheren.

<b>Toelichting</b>
GBx’en worden op de ZIM aangesloten via GZN-verbindingen. De ZIM houdt configuratiegegevens van deze GZN-verbindingen bij.""";
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Proposed";
    ea:version "1.0";
    dcterms:creator "Rob den Braasem";
    dcterms:created "2020-03-17 13:42:53";
    dcterms:modified "2020-03-17 13:44:10";
    dcterms:source "Eisen_AORTA_Infrastructuur_nf_xml.xml";
