<urn:researchmaster:aorta:req:8f48dd6c-f33f-5065-80dd-4f066774dead> a rm:Requirement;
    dcterms:identifier "8F48DD6C-F33F-5065-80DD-4F066774DEAD";
    dcterms:title "Vastleggen van toegangsgebeurtenissen in de toegangslog";
    ea:alias "LSP.ZIM.e4050 ";
    dcterms:description """Bij de afhandeling van berichten logt de ZIM de berichtenuitwisseling zoals beschreven in [Arch AORTA] en [Ontw TGL]. Al het berichtenverkeer dient gelogd te worden volgens het datamodel zoals is opgenomen in de NEN 7513:2018.

<b>Functie</b>
Deze eis faciliteert dat de toegang tot gegevens via AORTA traceerbaar is voor patiënt en toezichthouders.

<b>Toelichting</b>
Zie paragraaf 13.2.7 van [Arch AORTA], [Ontw TGL] en NEN 7513:2018 hoofdstuk 7""";
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Proposed";
    ea:version "1.0";
    dcterms:creator "Rob den Braasem";
