<urn:researchmaster:aorta:req:b7239891-f17d-5bcd-b31e-756a6a762f5b> a rm:Requirement;
    dcterms:identifier "B7239891-F17D-5BCD-B31E-756A6A762F5B";
    dcterms:title "Bevorderen interoperabiliteit bij berichtuitwisseling";
    ea:alias "GBX.CON.e4066";
    dcterms:description """<b>Eis:</b>
Het GBX volgt voor berichtuitwisseling als bedoeld in eis GBX.CON.e4060 de WS-I Basic Profile 1.0 specificaties.""";
