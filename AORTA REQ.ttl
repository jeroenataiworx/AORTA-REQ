<urn:researchmaster:aorta:req:bac00310-4ab1-8561-a436-c76ea7fece99> a rm:Requirement;
    dcterms:identifier "BAC00310-4AB1-8561-A436-C76EA7FECE99";
    dcterms:title "Bijhouden Beheerlog";
    ea:alias "COMP.BEV.e4030";
    dcterms:description """<b>Eis:</b>
Het component dient een beheerlog bij te houden, waarin alle beheerhandelingen m.b.t. het betreffende component worden gelogd. 
<b>
</b><b>Toelichting bij eis:</b>
In de beheerlog worden alle acties opgenomen die door een specifieke systeembeheerder worden uitgevoerd met betrekking tot beheer van het systeem. Het beheerlog geeft onder andere de gebeurtenissen aan die de toegangsregeling betreffen, aanpassing van configuratiegegevens en aanpassing van autorisaties binnen de applicatie.  """;
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Proposed";
    ea:version "8.4.0.0";
    dcterms:creator "Bart Hoenderboom";
    dcterms:created "2022-12-29 10:35:55";
    dcterms:modified "2022-12-30 11:05:23";
    dcterms:source "Eisen_AORTA_Infrastructuur_nf_xml.xml";
    dcterms:source "Eisen_AORTA_Infrastructuur_xmi_11.xml";
    dcterms:source "Eisen_AORTA_Infrastructuur_xmi_21.xml";
