<urn:researchmaster:aorta:req:b4b9c3ef-d4a0-267a-9c4b-6b657904ee5c> a rm:Requirement;
    dcterms:identifier "B4B9C3EF-D4A0-267A-9C4B-6B657904EE5C";
    dcterms:title "Uniek token exchange endpointadres voor resource server";
    ea:alias "DVZA.OTE.e4100";
    dcterms:description """<b>Eis:</b>
<b>
</b>De autorisatieserver moet een token exchange endpointadres beschikbaar stellen, die alleen toegankelijk is voor de resource server van de VZVZ DVZA.
<b>
</b><b>Toelichting bij eis:</b>""";
