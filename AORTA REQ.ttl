<urn:researchmaster:aorta:req:8a482d0e-ecf8-2d37-94fc-62dc3619bf69> a rm:Requirement;
    dcterms:identifier "8A482D0E-ECF8-2D37-94FC-62DC3619BF69";
    dcterms:title "Wijzigen logging";
    ea:alias "LSP.LOG.e4030 ";
    dcterms:description """Gegevens in de log mogen niet wijzigbaar of verwijderbaar (alleen in het kader van eis <b>LSP.LOG.e4023</b>) zijn. Het niet kunnen wijzigen/verwijderen van loggegevens moet worden afgedwongen door technische maatregelen. 

<b>Functie</b>
Onweerlegbaarheid garanderen van log.

<b>Toelichting</b>
Conform NEN 7513:2018 Paragraaf 6.4.3""";
