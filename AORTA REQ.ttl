<urn:researchmaster:aorta:req:85f55389-30bb-7ce5-bb4f-6e00cdd0f806> a rm:Requirement;
    dcterms:identifier "85F55389-30BB-7CE5-BB4F-6E00CDD0F806";
    dcterms:title "Infrastructurele berichten conform bestaande systeemrol";
    ea:alias "GBX.IMP.e4020";
    dcterms:description """<b>Eis:</b>
Een GBx-applicatie dient alle infrastructurele berichten behorende tot &#233;&#233;n systeemrol te ondersteunen in eenzelfde protocol.
<b>Toelichting bij eis:</b>
VZVZ geeft systeemrollen uit, waarin &#233;&#233;n of meerdere interacties zijn opgenomen. Interacties worden in sommige gevallen gegroepeerd, omdat ze onlosmakelijk met elkaar verbonden zijn. Indien een systeemrol aangeeft dat meerdere interacties verplicht zijn, dan dient een GBX-applicatie al deze interacties te ondersteunen in de berichtenprotocol zoals valt af te leiden uit de interactieID. """;
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Definitief";
    ea:version "8.4.0.0";
    dcterms:creator "Bart Hoenderboom";
    dcterms:created "2024-04-13 07:02:29";
    dcterms:modified "2024-04-13 07:16:11";
    dcterms:source "Eisen_AORTA_Infrastructuur_nf_xml.xml";
    dcterms:source "Eisen_AORTA_Infrastructuur_xmi_11.xml";
    dcterms:source "Eisen_AORTA_Infrastructuur_xmi_21.xml";
