<urn:researchmaster:aorta:req:86b10454-63f9-e72d-b4d6-0e15d4f1ad82> a rm:Requirement;
    dcterms:identifier "86B10454-63F9-E72D-B4D6-0E15D4F1AD82";
    dcterms:title "Beschikbaarheid BTD";
    ea:alias "BTD.BES.e4010";
    dcterms:description """<b>Eis:</b>
<b>
</b>BTD dient een beschikbaarheid te kunnen garanderen van minimaal 99.982%.
<b>
</b><b>Toelichting bij eis:</b>
<b>
</b>BTD zal o.a. onderdeel uitmaken van de AORTA-keten. Om de beschikbaarheid over de hele keten te kunnen blijven garanderen dient BTD te voldoen aan een bepaalde minimale beschikbaarheid.""";
