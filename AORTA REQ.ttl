<urn:researchmaster:aorta:req:8148dbeb-bc15-2b75-be29-3899a5954543> a rm:Requirement;
    dcterms:identifier "8148DBEB-BC15-2B75-BE29-3899A5954543";
    dcterms:title "Detectie en preventie van indringers";
    ea:alias "LSP.BVL.e4090 ";
    dcterms:description """De ZIM dient te zijn voorzien van maatregelen op het gebied van “intrusion detection<i>” </i>en<i> “</i>intrusion prevention”.

<b>Functie</b>
Er worden maatregelen genomen om gangbare categorieën van aanvallen die via het netwerk kunnen worden uitgevoerd op de ZIM te detecteren en vervolgens te bestrijden.

<b>Toelichting</b>
De intentie van deze eis is dat datgene wordt gedaan dat in de markt onder de gangbare maatregelen wordt gerekend op het gebied van “intrusion detection” en <i>“</i>intrusion prevention”.""";
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Proposed";
    ea:version "1.0";
    dcterms:creator "Rob den Braasem";
