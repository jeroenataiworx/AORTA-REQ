<urn:researchmaster:aorta:req:bc9d968c-bb98-2959-8a44-b0fdf5050563> a rm:Requirement;
    dcterms:identifier "BC9D968C-BB98-2959-8A44-B0FDF5050563";
    dcterms:title "Opleveren MedMij-berichten";
    ea:alias "DVZA.COM.e4060";
    dcterms:description """<b>Eis:</b>
<b>
</b>Bij een opvraag zoals gespecificeerd in het MedMij Afsprakenstelsel dienen alleen die antwoordberichten door de DVZA te worden teruggestuurd zoals gespecificeerd in het MedMij Afsprakenstelsel. 
<b>
</b><b>Toelichting bij eis:</b>
<b>
</b>Als gevolg van het gebruik van een afwijkende berichtstandaard binnen de AORTA infrastructuur en het MedMij Afsprakenstelsel is het mogelijk dat een MedMij-opvraag wordt vertaald naar meerdere antwoordberichten. Niet alle antwoordberichten hoeven echter een antwoord te zijn op de gestelde vraag.""";
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Definitief";
    ea:version "8.1.0.0";
    dcterms:creator "Bart Hoenderboom";
    dcterms:created "2018-10-16 15:19:17";
    dcterms:modified "2020-06-22 13:15:33";
    dcterms:source "Eisen_AORTA_Infrastructuur_nf_xml.xml";
    dcterms:source "Eisen_AORTA_Infrastructuur_xmi_11.xml";
    dcterms:source "Eisen_AORTA_Infrastructuur_xmi_21.xml";
