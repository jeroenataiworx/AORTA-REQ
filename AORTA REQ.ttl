<urn:researchmaster:aorta:req:adee0a30-4cdf-9975-ba1e-456d200a5ad7> a rm:Requirement;
    dcterms:identifier "ADEE0A30-4CDF-9975-BA1E-456D200A5AD7";
    dcterms:title "Terugzetten reservekopieën";
    ea:alias "LSP.BHB.e4170 ";
    dcterms:description """De ZIM-beheerapplicatie (ZBA) biedt de functie om een reservekopie van alle data van de ZIM te kunnen maken en om een reservekopie weer terug te zetten. 

<b>Functie</b>
Herstellen ZIM-datagegevens naar meest recente correcte staat.

<b>Toelichting</b>
De ZIM bevat informatie die kritisch is voor het functioneren van AORTA. Deze informatie moet hersteld kunnen worden in het geval van uitval van (onderdelen van) de ZIM.""";
    ea:stereotype "ArchiMate_Requirement";
    ea:status "Proposed";
    ea:version "1.0";
    dcterms:creator "Rob den Braasem";
